{
  "name": "cookieless-analytics-test",
  "private": true,
  "description": "What nine cookieless analytics tools store, send and record, tested in a real browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node src/commands/fetch.ts && node src/commands/make-cert.ts && playwright install chrome",
    "visit": "node src/commands/visit.ts",
    "urls": "node src/commands/urls.ts",
    "analyze": "node src/commands/analyze.ts",
    "blockcheck": "node src/commands/blockcheck.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "@plausible-analytics/tracker": "0.4.6",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
